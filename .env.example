# Telegram/App settings
APP_TITLE="IceBel Contracts"
TIMEZONE=Europe/Minsk

# Google Drive Integration (optional on local, recommended on Vercel)
# Auth Mode: service_account or oauth
GOOGLE_AUTH_MODE=service_account
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# For Vercel: paste the entire Service Account JSON string into this env variable:
GOOGLE_SERVICE_ACCOUNT_JSON=

# For local file mode:
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
